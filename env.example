# Copy to .env (cp env.example .env) and fill in. Never commit .env.

# Local development: DEBUG=1 lets you skip SECRET_KEY and uses SQLite (backend/db.sqlite3).
DEBUG=0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=patrimonio.example.com
CSRF_TRUSTED_ORIGINS=https://patrimonio.example.com
TIME_ZONE=America/New_York

# Postgres (docker-compose). Leave DATABASE_URL unset locally to use SQLite.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# Set to 0 only if TLS is terminated somewhere that doesn't send X-Forwarded-Proto.
SECURE_SSL_REDIRECT=1

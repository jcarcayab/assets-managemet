# Copy to .env (cp env.example .env) and fill in. Never commit .env.

# Local development: DEBUG=1 lets you skip SECRET_KEY and uses SQLite (backend/db.sqlite3).
DEBUG=0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=patrimonio.example.com
CSRF_TRUSTED_ORIGINS=https://patrimonio.example.com
TIME_ZONE=America/New_York

# Postgres (docker-compose). Leave DATABASE_URL unset locally to use SQLite.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# Set to 0 only if TLS is terminated somewhere that doesn't send X-Forwarded-Proto.
SECURE_SSL_REDIRECT=1

# Every user must set up two-factor authentication before using the app. Recommended when hosted.
MFA_REQUIRED=1
# Encrypts secrets stored in the DB (2FA seeds, bank-connection tokens). Generate like SECRET_KEY, keep it
# with your backups, and never change it (stored secrets would become unreadable).
FIELD_ENCRYPTION_KEY=

# Plaid (https://dashboard.plaid.com/developers/keys). Start with sandbox (free test banks: user_good / pass_good);
# production requires Plaid's approval and is billed per connected institution.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Only for OAuth institutions in production; must also be registered in the Plaid dashboard.
PLAID_REDIRECT_URI=
